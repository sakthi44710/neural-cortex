# ====================================================================
# NEURAL CORTEX - ENVIRONMENT VARIABLES TEMPLATE
# ====================================================================
# Copy this file to .env for local development, or use these keys
# when configuring Environment Variables in your Vercel Project Settings.

# 1. DATABASE CONFIGURATION (TiDB Serverless / MySQL Compatible)
# --------------------------------------------------------------------
# Connection string with strict SSL mode required by TiDB Cloud
DATABASE_URL="mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/main?sslaccept=strict"

# 2. NEXTAUTH CONFIGURATION
# --------------------------------------------------------------------
# Secret used to encrypt session tokens (e.g. generate via openssl rand -base64 32)
NEXTAUTH_SECRET="your_nextauth_secret_here"

# IMPORTANT FOR VERCEL DEPLOYMENTS:
# In local development: http://localhost:3000
# On Vercel production: Set this to your actual Vercel domain:
# e.g., https://neural-cortex.vercel.app (or custom domain)
# DO NOT keep http://localhost:3000 on Vercel or authentication redirects will fail!
NEXTAUTH_URL="https://your-project-name.vercel.app"

# 3. GOOGLE OAUTH CREDENTIALS
# --------------------------------------------------------------------
# In Google Cloud Console > Credentials > Authorized redirect URIs, add:
# - http://localhost:3000/api/auth/callback/google
# - https://<your-project-name>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# 4. STORAGE (Vercel Blob Storage)
# --------------------------------------------------------------------
# Required for document uploads in Vault and Study modules
BLOB_READ_WRITE_TOKEN="your_vercel_blob_read_write_token"

# 5. AI INFERENCE ENGINES
# --------------------------------------------------------------------
# NVIDIA NIM API (Primary engine: Meta Llama 3.3 70B Instruct)
NVIDIA_API_KEY="your_nvidia_nim_api_key"

# Hugging Face API (Fallback LLM inference and embeddings)
HUGGINGFACE_API_KEY="your_huggingface_api_key"

# 6. EMAIL / SMTP (Optional - Password Reset OTP)
# --------------------------------------------------------------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
